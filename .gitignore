# La bibliotheque embarquee (pdfexact/fonts/) EST suivie : c'est elle qui rend le
# projet autonome. Seul le dossier d'extension de la racine est ignore, ainsi que
# fonts/local/, ou l'audit de licences met en quarantaine le non redistribuable.
/fonts/*
!/fonts/LISEZ-MOI.md
!/fonts/local/
/fonts/local/*
!/fonts/local/ebgaramond/
/fonts/local/ebgaramond/*
!/fonts/local/ebgaramond/*.otf
!/fonts/local/licenses/
/fonts/local/licenses/*
!/fonts/local/licenses/EBGaramond*-Debian-copyright

.fastocr/
tests/logs_converter/
tests/tests_documents_convertis/
